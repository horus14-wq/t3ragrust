// quick check: what does Dual produce with the Xenova minilm tokenizer
#[test]
fn minilm_dual_encoding() {
    let p = std::path::Path::new("/home/ubuntu/.cache/huggingface/hub/models--Xenova--ms-marco-MiniLM-L-6-v2/snapshots/a09144355adeed5f58c8ed011d209bf8ee5a1fec/tokenizer.json");
    let mut t = tokenizers::Tokenizer::from_file(p).unwrap();
    t.with_truncation(Some(tokenizers::TruncationParams { max_length: 512, ..Default::default() })).unwrap();
    t.with_padding(Some(tokenizers::PaddingParams { pad_id: 0, pad_token: "[PAD]".into(), ..Default::default() }));
    let e = t.encode(tokenizers::EncodeInput::Dual("what is rust".into(), "rust is a language".into()), true).unwrap();
    eprintln!("single len={} ids={:?}", e.get_ids().len(), e.get_ids());
    let b = t.encode_batch(vec![tokenizers::EncodeInput::Dual("a".into(), "b".into())], true).unwrap();
    eprintln!("batch len={} ids={:?}", b[0].get_ids().len(), b[0].get_ids());
}
